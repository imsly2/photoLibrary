# Runtime catalog, originals, renditions, locks, and logs. Never track these.
library-data/

# Optional private samples. Deterministic fixtures elsewhere may be tracked.
tests/fixtures/user-samples/*
!tests/fixtures/user-samples/.gitkeep

# Local QA sandboxes created inside the tree.
.qa/
tmp/

# Slice evidence may keep summary JSON. Do not track the temporary roots
# or fixture copies the runner leaves beside those summaries.
docs/features/**/fixture-sandbox/
docs/features/**/*-root/
docs/features/**/barrier-*/
docs/features/**/unmarked-root/
docs/features/**/write.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS
Thumbs.db
Desktop.ini
.DS_Store
